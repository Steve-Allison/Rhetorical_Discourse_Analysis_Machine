{
  // The linted set is computed by scripts/lint_markdown.py (all repository
  // Markdown minus its declared exclusion classes). Only rules that conflict
  // with durable document semantics are disabled.
  "config": {
    // Parallel per-command or per-scenario sections legitimately repeat
    // headings such as "Synopsis" under different parents; only duplicates
    // among sibling headings are defects.
    "MD024": { "siblings_only": true },

    // Long lines are required for opaque URLs, generated hashes, and wide
    // evidence tables; wrapping them would change or obscure their meaning.
    "MD013": false,

    // Inline HTML is a required authoring primitive for README badges,
    // collapsible details, and rendered evidence anchors.
    "MD033": false,

    // Tables use valid compact, tight, and alignment-focused forms according
    // to their content; rendered column integrity is enforced by MD056.
    "MD060": false
  },
  "overrides": [
    {
      // Project-memory records carry their title in required YAML front matter.
      "filter": [".claude/memory/*.md"],
      "config": { "MD041": false },
      "combine": "merge"
    },
    {
      // This parser fixture intentionally begins with lead-in prose before H2.
      "filter": ["tests/fixtures/markdown/multi-level.md"],
      "config": { "MD041": false },
      "combine": "merge"
    }
  ]
}
