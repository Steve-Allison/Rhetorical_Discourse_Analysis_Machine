{"$defs":{"AvailableCapability":{"additionalProperties":false,"properties":{"contract_version":{"$ref":"#/$defs/SemanticVersion"},"provider_id":{"minLength":1,"title":"Provider Id","type":"string"},"state":{"const":"available","default":"available","title":"State","type":"string"}},"required":["provider_id","contract_version"],"title":"AvailableCapability","type":"object"},"CapabilityState":{"discriminator":{"mapping":{"available":"#/$defs/AvailableCapability","unavailable":"#/$defs/UnavailableCapability"},"propertyName":"state"},"oneOf":[{"$ref":"#/$defs/AvailableCapability"},{"$ref":"#/$defs/UnavailableCapability"}]},"FormalismDeclaration":{"additionalProperties":false,"description":"One result-kind a provider emits, carrying its own canonical identity and state.","properties":{"capability":{"$ref":"#/$defs/CapabilityState"},"formalism_id":{"pattern":"^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$","title":"Formalism Id","type":"string"},"technique":{"$ref":"#/$defs/Technique"},"technique_curie":{"minLength":1,"title":"Technique Curie","type":"string"}},"required":["formalism_id","technique","technique_curie","capability"],"title":"FormalismDeclaration","type":"object"},"SemanticVersion":{"description":"Normalized ``major.minor.patch`` with no prerelease or local suffix.","title":"SemanticVersion","type":"string"},"Sha256Identity":{"additionalProperties":false,"description":"Unambiguous SHA-256 identity used by every semantic digest field.","properties":{"algorithm":{"const":"sha256","default":"sha256","title":"Algorithm","type":"string"},"hex_digest":{"pattern":"^[0-9a-f]{64}$","title":"Hex Digest","type":"string"}},"required":["hex_digest"],"title":"Sha256Identity","type":"object"},"Technique":{"description":"The framework identities the machine knows, keyed by their short name in Central.","enum":["rst","erst","pdtb","sdrt","toulmin","walton","dung","ibis"],"title":"Technique","type":"string"},"TechniqueCapability":{"additionalProperties":false,"properties":{"capability":{"$r